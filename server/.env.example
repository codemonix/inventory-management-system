# Copy to server/.env for `npm run dev`
DB_URI=mongodb://localhost:27017/ims?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# "true" lets self-registered users log in without admin approval
DEFAULT_USER_APPROVED=false
# Comma-separated origins allowed to call the API cross-origin (dev defaults to any origin)
# CORS_ORIGIN=http://localhost:5173

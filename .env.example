# Copy to .env (next to the compose files). Used by docker-compose.yml and docker-compose.ims.yml.
# Use URL-safe passwords (letters, digits, - _ .) because they are embedded in the MongoDB URI.

# MongoDB root account (created on first boot of an empty volume; also used by mongo-init)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Least-privilege account the backend connects with (readWrite on MONGO_APP_DB only)
MONGO_APP_DB=ims
MONGO_APP_USERNAME=ims_app
MONGO_APP_PASSWORD=change-me-app

# Backend (docker-compose.yml only; production reads these from .env.backend)
JWT_SECRET=change-me-to-a-long-random-string
DEFAULT_USER_APPROVED=false

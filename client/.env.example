# Copy to client/.env for `npm run dev`. The dev server calls ${VITE_API_BASE_URL}:${VITE_API_PORT}/api/
# (match PORT in server/.env). Production builds read the API URL from public/config.js instead.
VITE_API_BASE_URL=http://localhost
VITE_API_PORT=4000
# "true" prints debug logs in the browser console
VITE_LOG_MODE=true
